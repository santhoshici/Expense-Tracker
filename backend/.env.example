# Backend Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit the real .env file (contains secrets)

# Server port
PORT=8000

# MongoDB connection string
# Format: mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
MONGO_URI=

# JWT secret for token signing (generate with: openssl rand -hex 32)
JWT_SECRET=

# Frontend URL for CORS (development: http://localhost:5173, production: frontend service URL)
CLIENT_URL=http://localhost:5173

# Redis connection URL (optional - app uses in-memory fallback if empty)
# Format: rediss://default:<password>@<host>:6379
REDIS_URL=

# Google Gemini API key for AI copilot (get free key at https://aistudio.google.com/app/apikey)
# App falls back to rule-based engine if empty
GEMINI_API_KEY=

# Per-user daily AI query limit
AI_DAILY_QUOTA=10

# FastAPI ML microservice URL (optional - app degrades gracefully if unreachable)
ML_SERVICE_URL=http://127.0.0.1:8000

# Node environment (development, production, test)
NODE_ENV=development
